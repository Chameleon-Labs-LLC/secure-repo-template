# Supply-chain floor for `npm install`: refuse package versions published fewer
# than 7 days ago. Most malicious releases are found and pulled within days, so
# waiting a week avoids most of them. Needs npm 11.10 or later; older npm warns
# and ignores the setting.
# `npm ci` installs the lockfile exactly as written and is unaffected.
#
# The one override: a security fix younger than 7 days. Apply it at once:
#   npm install <pkg>@<fixed-version> --min-release-age=0
# Guide: docs/security-setup.md, step 5.
min-release-age=7
